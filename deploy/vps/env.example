# SoDEX collector and publisher settings. install.sh copies this to .env (readable only by you).
# Edit with:  nano ~/sodex/.env      then restart:  systemctl --user restart sodex-collector sodex-publisher

# ── Collector ────────────────────────────────────────────────────────────
# SoDEX allows 1200 REST weight per minute per IP, shared with your trading bots.
# 240 leaves them 960. Lower it if a bot ever gets rate limited.
COLLECTOR_REST_WEIGHT=240

# Deposits and withdrawals (1 = on). First run reads every account's ledger: a day or two.
COLLECTOR_FUNDS=0
COLLECTOR_FUNDS_RPS=2

# Open positions (1 = on). First run checks every trader: about half a day.
# Snapshots use part of COLLECTOR_REST_WEIGHT above (5 each).
COLLECTOR_POSITIONS=0
COLLECTOR_POSITIONS_WEIGHT=120

# Nickname scramble. install.sh fills these with random values once. Never change them
# afterwards: every trader's nickname (and alert follows) would change.
NICKNAME_MUL=
NICKNAME_ADD=

# ── Publisher ────────────────────────────────────────────────────────────
# Supabase project URL and SERVICE ROLE key (Project Settings → API).
# The service key can write anything: keep it only here, never on the site.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
COLLECTOR_DB=/home/collector/sodex/collector/data/collector.db

# ── Telegram alerts (optional) ───────────────────────────────────────────
# Bot token from @BotFather. Empty = alerts off.
TELEGRAM_BOT_TOKEN=
# The site's public address, for links in alerts, e.g. https://example.com
SITE_URL=
